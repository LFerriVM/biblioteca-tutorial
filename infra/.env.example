# Copie este arquivo para infra/.env (o .gitignore já ignora .env) e cole a
# chave gerada em https://aistudio.google.com/apikey. O docker compose lê o
# infra/.env sozinho e repassa a variável ao serviço app.
GEMINI_API_KEY=
# Distância cosseno máxima para considerar um livro relevante (depende do modelo).
SEMANTIC_MAX_DISTANCE=0.38
